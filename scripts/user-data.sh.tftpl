#!/bin/bash
# userData for the app instances (A4). Terraform template: what sits between $${...} and the
# %%{ if } directives is resolved by templatefile() at the root; bash variables go WITHOUT braces
# so Terraform does not interpret them.
#
# With artifact and document bucket: 1) /etc/docuprocess.env with the configuration (secrets are
# read from Parameter Store, they never travel here); 2) Node.js 24 from the AL2023 repositories
# (reached via the S3 gateway endpoint, no internet); 3) versioned artifact from S3;
# 4) systemd services; 5) waits for the API to reach MySQL (/api/ready).
# Without them (B2 not merged) it brings up the A3 provisional server.
set -euo pipefail
exec > >(tee -a /var/log/docuprocess-userdata.log) 2>&1
echo "$(date -Is) userData: inicio"

APP_DIR=/opt/docuprocess

%{ if artifact_key != "" && docs_bucket != "" ~}
# Secret versions in Parameter Store: db_password v${db_password_version}, jwt_secret v${jwt_secret_version}.
# If a secret changes, its version changes, change this text and a new launch
# template version comes out: instances are replaced and read the new value (rotation with no manual steps).
REGION="${aws_region}"
ENV_FILE=/etc/docuprocess.env

# Retries a command (VPC endpoints can take a few seconds to start).
retry() {
  local n=1 max=10
  until "$@"; do
    if [ "$n" -ge "$max" ]; then
      echo "$(date -Is) ERROR: falló $n veces: $1 $2" >&2
      return 1
    fi
    echo "$(date -Is) reintento $n/$max: $1 $2"
    sleep $((n * 3))
    n=$((n + 1))
  done
}

# Reads a SecureString from Parameter Store (via the SSM interface endpoint; SSM decryption with aws/ssm).
get_secret() {
  retry aws ssm get-parameter --region "$REGION" --name "$1" --with-decryption \
    --query Parameter.Value --output text
}

# Escapes a value for systemd EnvironmentFile between double quotes. Terraform already validates that
# the secrets are printable ASCII without spaces (no line breaks that would break the file).
quote() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# --- 1. Configuration (docs/architecture.md contract, section 3)
DB_PASSWORD="$(get_secret "${db_password_param}")"
JWT_SECRET="$(get_secret "${jwt_secret_param}")"

umask 077
cat > "$ENV_FILE" <<ENV
AWS_REGION=${aws_region}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=$(quote "$DB_PASSWORD")
JWT_SECRET=$(quote "$JWT_SECRET")
# DDB_TABLE, DDB_EVENTS_TABLE and DOCS_BUCKET are mandatory for the API: if any
# is missing the process does not start. DDB_TRANSACTIONS=false is a fallback
# (sequential writes instead of a transaction); transactions work in the
# Sandbox —tested on November 11 and 13—; it is only used if a policy denies
# the transaction item actions.
DDB_TABLE=${ddb_table}
DDB_EVENTS_TABLE=${ddb_events_table}
DDB_TRANSACTIONS=${ddb_transactions}
DOCS_BUCKET=${docs_bucket}
SNS_TOPIC_ARN=${sns_topic_arn}
ARTIFACTS_BUCKET=${artifacts_bucket}
WORKER_POLL_SECONDS=${worker_poll_seconds}
WORKER_BATCH_SIZE=${worker_batch_size}
UPLOAD_TIMEOUT_MINUTES=${upload_timeout_minutes}
MAX_FILE_MB=${max_file_mb}
LOG_LEVEL=INFO
ENV
unset DB_PASSWORD JWT_SECRET
chown root:root "$ENV_FILE"
chmod 600 "$ENV_FILE"
umask 022
echo "$(date -Is) $ENV_FILE escrito"

# --- 2. Node.js 24 (AL2023 package; the repository lives in S3 and is reached via the gateway endpoint)
retry dnf install -y -q nodejs24
NODE_BIN="$(command -v node)"
echo "$(date -Is) Node $("$NODE_BIN" --version) en $NODE_BIN"

# --- 3. Hash-versioned artifact (Terraform uploads it; the B2 bucket policy grants GetObject to the role)
retry aws s3 cp --region "$REGION" --only-show-errors \
  "s3://${artifacts_bucket}/${artifact_key}" /tmp/docuprocess-app.zip
rm -rf "$APP_DIR"
mkdir -p "$APP_DIR"
python3 -m zipfile -e /tmp/docuprocess-app.zip "$APP_DIR"
rm -f /tmp/docuprocess-app.zip
echo "${artifact_key}" > "$APP_DIR/RELEASE"
echo "$(date -Is) artefacto ${artifact_key} en $APP_DIR"

# --- 4. systemd services (run as an unprivileged user; logs to journald)
id docuprocess >/dev/null 2>&1 || useradd --system --no-create-home --shell /sbin/nologin docuprocess

write_unit() { # write_unit <name> <description> <input file> [Environment extra]
  local extra_env=""
  if [ -n "$${4:-}" ]; then extra_env="Environment=$4"; fi
  cat > "/etc/systemd/system/docuprocess-$1.service" <<UNIT
[Unit]
Description=DocuProcess - $2
After=network-online.target
Wants=network-online.target

[Service]
User=docuprocess
Group=docuprocess
WorkingDirectory=$APP_DIR/$1
EnvironmentFile=$ENV_FILE
Environment=NODE_ENV=production
$extra_env
ExecStart=$NODE_BIN $APP_DIR/$1/$3
Restart=always
RestartSec=3
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/tmp
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
UNIT
}

SERVICES=()
write_unit api "API REST" dist/server.js "WEB_CONCURRENCY=2 PORT=8000"
SERVICES+=(docuprocess-api.service)
if [ -f "$APP_DIR/worker/package.json" ]; then
  # Worker entry point (B5): the "main" field of its package.json or, if undefined, dist/worker.js.
  WORKER_MAIN="$("$NODE_BIN" -p "require('$APP_DIR/worker/package.json').main || 'dist/worker.js'")"
  write_unit worker "worker de procesamiento" "$WORKER_MAIN"
  SERVICES+=(docuprocess-worker.service)
else
  echo "$(date -Is) el artefacto no trae worker: solo la API"
fi

systemctl daemon-reload

# --- 5. Readiness BEFORE opening port 8000: the instance can only end up healthy if the API reaches
# MySQL with its credentials. A temporary API is raised on 8001 (the ALB cannot see it) with the same
# user and the same EnvironmentFile, and GET /api/ready is awaited. Only if it returns 200 do the real
# services start (8000). Otherwise they never start: the target never turns healthy, Terraform does not
# mark the new ASG as created and the previous one keeps serving. The ALB uses /api/health (superficial)
# so an RDS outage in production does not recycle every instance.
# Deadline: 180 s (within the ASG's 300 s grace period). Each attempt waits up to 15 s because an
# unreachable MySQL takes ~10 s to return ETIMEDOUT.
systemd-run --unit=docuprocess-readiness --quiet \
  -p User=docuprocess -p EnvironmentFile="$ENV_FILE" -p WorkingDirectory="$APP_DIR/api" \
  -E NODE_ENV=production -E PORT=8001 -E WEB_CONCURRENCY=1 \
  "$NODE_BIN" "$APP_DIR/api/dist/server.js"
ready=false
deadline=$((SECONDS + 180))
while [ "$SECONDS" -lt "$deadline" ]; do
  if curl -fsS -m 15 http://127.0.0.1:8001/api/ready >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 5
done
journalctl -u docuprocess-readiness --no-pager -o cat | grep -E "ready|WARN|ERROR" | tail -5 || true
systemctl stop docuprocess-readiness || true

if [ "$ready" != true ]; then
  echo "$(date -Is) ERROR: /api/ready no respondió 200 en 180 s (¿RDS, SG o contraseña?)." >&2
  echo "$(date -Is) Los servicios NO se arrancan: la instancia no recibirá tráfico." >&2
  exit 1
fi

systemctl enable --now "$${SERVICES[@]}"
echo "$(date -Is) userData: listo, API lista con MySQL ($${SERVICES[*]})"
%{ else ~}
# --- Without artifact or without document bucket (B2 not merged): A3 provisional server,
# 200 on /api/health over port 8000. It reads no secrets: it does not need them.
mkdir -p "$APP_DIR/placeholder/api"
echo '{"status":"ok","placeholder":true}' > "$APP_DIR/placeholder/api/health"

cat > /etc/systemd/system/docuprocess-placeholder.service <<'UNIT'
[Unit]
Description=DocuProcess - servidor provisional de health check (A3)
After=network-online.target
Wants=network-online.target

[Service]
User=nobody
ExecStart=/usr/bin/python3 -m http.server 8000 --bind 0.0.0.0 --directory /opt/docuprocess/placeholder
Restart=always

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now docuprocess-placeholder.service
echo "$(date -Is) userData: listo (provisional, sin artefacto)"
%{ endif ~}
