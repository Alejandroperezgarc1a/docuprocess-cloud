# Configuración para desarrollo local. Copiar a .env (ignorado por git) y completar.
# En AWS estas mismas variables viven en /etc/docuprocess.env, que escribe el userData.
# Ver docs/architecture.md, sección 3.

# --- Base de datos (MySQL local de docker-compose; en AWS: RDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=docuprocess
DB_USER=docuadmin
DB_PASSWORD=CAMBIAR-password-local
# Solo para el contenedor local de MySQL
MYSQL_ROOT_PASSWORD=CAMBIAR-root-local

# --- Autenticación (mínimo 32 caracteres; generar con: openssl rand -hex 32)
JWT_SECRET=CAMBIAR-secreto-jwt-de-al-menos-32-caracteres

# --- AWS
AWS_REGION=us-east-1
# Tablas de documentos y eventos, y endpoint de DynamoDB Local (en AWS no se define DDB_ENDPOINT_URL)
DDB_TABLE=documents
DDB_EVENTS_TABLE=document_events
# true: estado + evento en una transaccion atomica. false: escritura secuencial (fallback del Sandbox)
DDB_TRANSACTIONS=true
DDB_ENDPOINT_URL=http://localhost:8001
# Obligatorio para la API (no puede estar vacío): genera URLs prefirmadas.
# En local usa el bucket real del Sandbox para completar el PUT a S3.
DOCS_BUCKET=
# Vacío en local: el worker registra la notificación en el log en lugar de publicar en SNS
SNS_TOPIC_ARN=
# Solo lo usa el userData en AWS
ARTIFACTS_BUCKET=

# --- Solo desarrollo local
# Origen del frontend con Vite (`npm run dev` en frontend/). En AWS no hace falta:
# el mismo origen vía CloudFront.
CORS_ALLOWED_ORIGINS=http://localhost:5500

# --- Worker (opcionales)
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=10
UPLOAD_TIMEOUT_MINUTES=15
# FAILED automático para documentos atascados en PROCESSING
PROCESSING_TIMEOUT_MINUTES=30
MAX_FILE_MB=10
# Correos con rol admin (separados por coma); se promueven al arrancar la API
ADMIN_EMAILS=
LOG_LEVEL=INFO
