{
  "name": "docuprocess-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Worker asincrono de DocuProcess Cloud (procesamiento de documentos).",
  "main": "dist/worker.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "dev": "tsx watch src/worker.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "RUN_INTEGRATION=1 tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-sns": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "file-type": "^22.3.0",
    "image-size": "^2.1.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
